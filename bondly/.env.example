# ── Lightstone ───────────────────────────────────────────────────────────────
# Register at https://portal.apis.lightstone.co.za
# Account must be validated + POPIA contract signed before keys are issued.
LIGHTSTONE_API_KEY=your_subscription_key_here
LIGHTSTONE_BASE_URL=https://portal.apis.lightstone.co.za
LIGHTSTONE_MOCK_MODE=True    # Set to False once you have real credentials

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...    # Single price for homeowner access

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080     # 7 days

# ── App ──────────────────────────────────────────────────────────────────────
BASE_URL=https://api.bondly.co.za
DB_PATH=./bondly/data/app.db
