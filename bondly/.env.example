# ── Deeds provider ───────────────────────────────────────────────────────────
# Options: "mock" (dev), "afrigis", "datanamix"
DEEDS_PROVIDER=mock

# AfriGIS — https://developers.afrigis.co.za (free trial available)
AFRIGIS_CLIENT_ID=
AFRIGIS_CLIENT_SECRET=

# Datanamix — https://www.datanamix.com/developers-page/ (pay-per-result)
DATANAMIX_API_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────────────
BASE_URL=https://api.bondly.co.za
DB_PATH=./bondly/data/app.db
