# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get this by running: stripe listen --forward-to localhost:8000/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products + prices in Stripe dashboard, then paste the price IDs here
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...

# ── App ──────────────────────────────────────────────────────────────────────
# Used to build Stripe success/cancel redirect URLs
BASE_URL=http://localhost:8000

# SQLite database path
DB_PATH=./data/app.db

# How often to refresh scraped rate data (hours)
SCRAPER_REFRESH_HOURS=6
